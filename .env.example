# Copy to .env and fill in for your environment, then: `source .env && ./deploy.sh`
# Do NOT commit your filled-in .env (it is gitignored).

# --- Required: AWS + existing platform integration points ---
export AWS_REGION="us-east-1"
export VPC_ID="vpc-xxxxxxxx"
export PRIVATE_SUBNET_IDS="subnet-aaaa,subnet-bbbb"
export ECS_CLUSTER_NAME="my-cluster"
export ECS_SECURITY_GROUP_ID="sg-xxxxxxxx"
export ECS_TASK_EXECUTION_ROLE_ARN="arn:aws:iam::111122223333:role/my-ecs-execution-role"
export SERVICE_DISCOVERY_NS_ID="ns-xxxxxxxx"
export ALB_ARN="arn:aws:elasticloadbalancing:us-east-1:111122223333:loadbalancer/app/my-alb/abc123"
export ALB_DNS_NAME="my-alb-123456.us-east-1.elb.amazonaws.com"

# --- Recommended ---
export COGNITO_USER_POOL_ID=""        # blank disables dashboard auth (not recommended)
export COGNITO_CLIENT_ID=""
export LITELLM_URL="http://litellm.my-namespace.local:4000"
export LITELLM_MASTER_KEY=""          # prefer AWS Secrets Manager in production
export TEMPORAL_ADDRESS="temporal.my-namespace.local:7233"

# --- Optional ---
export ENV_NAME="ai-spm"
export SPM_LISTENER_PORT="8090"

# --- Optional: capabilities & extensibility ---
# Third-party plugin modules (detectors/rules/scanners/sinks), comma-separated import paths
export SPM_PLUGINS=""
# Amazon Bedrock Guardrails enforcement in the proxy
export SPM_BEDROCK_GUARDRAIL_ID=""
export SPM_BEDROCK_GUARDRAIL_VERSION="DRAFT"
# Bedrock classifier model (the task role may invoke only these two IDs)
export SPM_CLASSIFIER_MODEL_ID="us.anthropic.claude-3-5-haiku-20241022-v1:0"
export SPM_CLASSIFIER_FOUNDATION_MODEL_ID="anthropic.claude-3-5-haiku-20241022-v1:0"
# Govern rule toggles
export SPM_APPROVED_MODELS=""          # e.g. "claude-3-5-sonnet,claude-3-5-haiku"
export SPM_REQUIRE_GUARDRAIL=""        # "true" activates missing_guardrail_association
# AIDR integrations
export SPM_SECURITY_HUB_ENABLED=""     # "true" exports findings to Security Hub (ASFF)
export SPM_GUARDDUTY_ENABLED=""        # "true" ingests GuardDuty AI Protection findings
export SPM_ANALYZE_IDENTITY=""         # "true" analyzes agent execution-role privilege (ASI03)
# Intent-based detection + autonomous response
export SPM_GUARDIAN_MODE="off"         # off | recommend | auto
export SPM_INTENT_LLM=""               # "true" enables the Bedrock intent-alignment classifier
export SPM_INTENT_BASELINE_FACTOR="3.0"
export SPM_SNS_TOPIC_ARN=""            # SNS topic for high-severity alerts
export SPM_EVENT_BUS_NAME=""           # EventBridge bus for high-severity events
