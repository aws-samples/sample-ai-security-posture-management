# Copy to .env and fill in for your environment, then: `source .env && ./deploy.sh`
# Do NOT commit your filled-in .env (it is gitignored).

# --- Required: AWS + existing platform integration points ---
export AWS_REGION="us-east-1"
export VPC_ID="vpc-xxxxxxxx"
export PRIVATE_SUBNET_IDS="subnet-aaaa,subnet-bbbb"
export ECS_CLUSTER_NAME="my-cluster"
export ECS_SECURITY_GROUP_ID="sg-xxxxxxxx"
export ECS_TASK_EXECUTION_ROLE_ARN="arn:aws:iam::111122223333:role/my-ecs-execution-role"
export SERVICE_DISCOVERY_NS_ID="ns-xxxxxxxx"
export ALB_ARN="arn:aws:elasticloadbalancing:us-east-1:111122223333:loadbalancer/app/my-alb/abc123"
export ALB_DNS_NAME="my-alb-123456.us-east-1.elb.amazonaws.com"

# --- Recommended ---
export COGNITO_USER_POOL_ID=""        # blank disables dashboard auth (not recommended)
export COGNITO_CLIENT_ID=""
export LITELLM_URL="http://litellm.my-namespace.local:4000"
export LITELLM_MASTER_KEY=""          # prefer AWS Secrets Manager in production
export TEMPORAL_ADDRESS="temporal.my-namespace.local:7233"

# --- Optional ---
export ENV_NAME="ai-spm"
export SPM_LISTENER_PORT="8090"
