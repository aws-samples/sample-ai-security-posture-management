FROM public.ecr.aws/docker/library/python:3.12-slim

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY spm/ spm/
# Optional environment-specific config (KNOWN_WORKFLOWS / EXPECTED_DEPS).
# Mount or bake your own and point SPM_CONFIG_FILE at it.
COPY config/ config/

ENV PYTHONUNBUFFERED=1

EXPOSE 8001

CMD ["uvicorn", "spm.api.main:app", "--host", "0.0.0.0", "--port", "8001"]
